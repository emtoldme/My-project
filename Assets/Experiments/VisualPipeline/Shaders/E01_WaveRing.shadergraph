    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 p = (UV.xy - 0.5) * QuadMeters;\nfloat band = abs(length(p) - Radius);\nAlpha = band < max(Width, 0.0001) ? 1 : 0;\n"
}

